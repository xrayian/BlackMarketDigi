# --- Stage 1: Build Frontend Assets ---
FROM node:22-alpine AS builder

WORKDIR /app
ENV NODE_OPTIONS="--max-old-space-size=512"

# Copy root and package manifests for workspace dependency resolution
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/server/package*.json ./packages/server/
COPY packages/client/package*.json ./packages/client/

# Install dependencies
RUN npm ci --prefer-offline --no-audit --no-fund

# Copy source code needed for shared and client
COPY tsconfig.json ./
COPY packages/shared ./packages/shared
COPY packages/client ./packages/client

# Build shared library first, then client SPA
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=packages/client

# --- Stage 2: Nginx Web Server & Reverse Proxy ---
FROM nginx:alpine AS runner

# Remove default nginx static html
RUN rm -rf /usr/share/nginx/html/*

# Copy built SPA bundle from builder stage
COPY --from=builder /app/packages/client/dist /usr/share/nginx/html

# Copy custom Nginx reverse proxy configuration
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
